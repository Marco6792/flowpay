# Sample MTN MoMo Configuration for Quick Start
# Copy these values to your .env file and replace with your actual credentials

# MTN Mobile Money Provider Settings - SANDBOX EXAMPLE
MTN_API_URL=https://sandbox.momodeveloper.mtn.com
MTN_TARGET_ENVIRONMENT=sandbox

# Sample Sandbox Credentials (Replace with your own)
# Generate these using the API or Postman collection
MTN_API_USER=d37a70c5-282d-4a71-9776-225c564c3349  # Example sandbox user
MTN_API_KEY=6f706bbeaeaf442489adb210bba4ba9a  # Example sandbox key
MTN_API_SECRET=6f706bbeaeaf442489adb210bba4ba9a  # Usually same as API key in sandbox

# Sample Subscription Keys from Postman Collection
# Get your own from https://momodeveloper.mtn.com/profile
MTN_COLLECTION_SUBSCRIPTION_KEY=4c91dae7a6f14743887a23a1f3d448eb7  # Example
MTN_DISBURSEMENT_SUBSCRIPTION_KEY=635951aafb4f46bc86df1ab2c928a75b  # Example
MTN_REMITTANCE_SUBSCRIPTION_KEY=80dbbaef060e4720a1089a018ba2bab8  # Example

# Legacy key (if you only have one subscription key)
MTN_SUBSCRIPTION_KEY=4c91dae7a6f14743887a23a1f3d448eb7

# Callback Configuration for Local Development
MTN_CALLBACK_URL=http://localhost:5000/api/v1/webhooks/mtn
MTN_PROVIDER_CALLBACK_HOST=localhost

# For testing with webhook.site (from Postman collection)
# MTN_CALLBACK_URL=https://webhook.site/mywebhooksandbox
# MTN_PROVIDER_CALLBACK_HOST=webhook.site

# TEST PHONE NUMBERS FOR SANDBOX
# Use these in your API calls for testing:
# 46733123450 - Will return FAILED status
# 46733123451 - Will return REJECTED status
# 46733123452 - Will return TIMEOUT status
# 56733123453 - Will return SUCCESS status
# 46733123454 - Will return PENDING status

# PRODUCTION CONFIGURATION EXAMPLE
# Uncomment and update for production deployment:
# MTN_API_URL=https://proxy.momoapi.mtn.com
# MTN_TARGET_ENVIRONMENT=production
# MTN_API_USER=<production-api-user>
# MTN_API_KEY=<production-api-key>
# MTN_API_SECRET=<production-api-secret>
# MTN_COLLECTION_SUBSCRIPTION_KEY=<production-collection-key>
# MTN_DISBURSEMENT_SUBSCRIPTION_KEY=<production-disbursement-key>
# MTN_REMITTANCE_SUBSCRIPTION_KEY=<production-remittance-key>
# MTN_CALLBACK_URL=https://your-domain.com/api/v1/webhooks/mtn
# MTN_PROVIDER_CALLBACK_HOST=your-domain.com