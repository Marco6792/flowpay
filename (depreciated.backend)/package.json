{
  "name": "@flowpay/backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nodemon src/index.ts",
    "dev:bun": "bun run typecheck:dev && bun run --watch src/index.ts",
    "dev:fast": "nodemon",
    "dev:fast:bun": "bun run --watch src/index.ts",
    "build": "bun run typecheck && bun build src/index.ts --outdir=dist --target=bun",
    "start": "bun run dist/index.js",
    "test": "bun test",
    "lint": "eslint src/**/*.ts",
    "typecheck": "tsc --noEmit --project tsconfig.dev.json",
    "typecheck:all": "tsc --noEmit",
    "typecheck:dev": "tsc --noEmit --project tsconfig.dev.json",
    "typecheck:watch": "tsc --noEmit --watch --project tsconfig.dev.json",
    "format": "prettier --write \"src/**/*.{ts,js,json}\"",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:seed": "bun run prisma/seed.ts"
  },
  "prisma": {
    "seed": "bun run prisma/seed.ts"
  },
  "dependencies": {
    "@fastify/cors": "^8.5.0",
    "@fastify/formbody": "^7.4.0",
    "@fastify/helmet": "^11.1.0",
    "@fastify/jwt": "^8.0.0",
    "@fastify/rate-limit": "^9.1.0",
    "@prisma/client": "^5.8.0",
    "@supabase/supabase-js": "^2.55.0",
    "@types/jsonwebtoken": "^9.0.10",
    "axios": "^1.11.0",
    "bcrypt": "^5.1.1",
    "bullmq": "^5.56.10",
    "fastify": "^4.25.0",
    "install": "^0.13.0",
    "ioredis": "^5.7.0",
    "jsonwebtoken": "^9.0.2",
    "pino": "^8.17.0",
    "pino-pretty": "^10.3.0",
    "winston": "^3.11.0",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/bun": "latest",
    "@types/node": "^20.10.0",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^6.16.0",
    "@typescript-eslint/parser": "^6.16.0",
    "aws-sdk": "^2.1692.0",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "mock-aws-s3": "^4.0.2",
    "nock": "^14.0.9",
    "nodemon": "^3.1.10",
    "prisma": "^5.8.0",
    "supertest": "^6.3.3",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.0",
    "vitest": "^3.2.4"
  }
}
