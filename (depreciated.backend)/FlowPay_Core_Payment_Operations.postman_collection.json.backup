{
  "info": {
    "name": "FlowPay Core Payment Operations",
    "description": "Comprehensive collection for FlowPay Core Payment Operations with all test scenarios. Organized by operation type with clear, understandable test names.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "version": "2.0.0"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:5000",
      "type": "string",
      "description": "Base URL for the FlowPay API"
    },
    {
      "key": "api_prefix",
      "value": "/api/v1",
      "type": "string",
      "description": "API version prefix"
    },
    {
      "key": "api_key",
      "value": "pk_live_EPcElqtBUvPJUFV9MpJv3s8RhGwX7nnH9bL2K5tAqZ1DcXmFkN4pV8sW2uR7J6G5",
      "type": "string",
      "description": "Development test API key"
    }
  ],
  "item": [
    {
      "name": "01. 🔧 Core API Operations",
      "item": [
        {
          "name": "✅ Health Check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}{{api_prefix}}/health",
              "host": ["{{base_url}}"],
              "path": ["{{api_prefix}}", "health"]
            }
          }
        },
        {
          "name": "🔑 Authentication Test",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "x-api-key",
                "value": "{{api_key}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}{{api_prefix}}/payments",
              "host": ["{{base_url}}"],
              "path": ["{{api_prefix}}", "payments"]
            }
          }
        },
        {
          "name": "📊 Payment Statistics",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "x-api-key",
                "value": "{{api_key}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}{{api_prefix}}/payments/stats",
              "host": ["{{base_url}}"],
              "path": ["{{api_prefix}}", "payments", "stats"]
            }
          }
        },
        {
          "name": "💰 Balance Aggregation",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "x-api-key",
                "value": "{{api_key}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}{{api_prefix}}/balance/aggregated",
              "host": ["{{base_url}}"],
              "path": ["{{api_prefix}}", "balance", "aggregated"]
            }
          }
        }
      ]
    },
