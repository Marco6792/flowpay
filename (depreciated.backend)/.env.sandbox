# FlowPay Sandbox Environment

# Core
NODE_ENV=development
PORT=5000
HOST=0.0.0.0

# Database (use docker service hostnames)
DATABASE_URL="postgresql://flowpay:flowpay_password@postgres:5432/flowpay?schema=public"

# Redis
REDIS_URL="redis://redis:6379"

# Security
JWT_SECRET=dev-local-sandbox-secret-change-me

# API
API_PREFIX=/api/v1
API_URL=http://localhost:5000
FRONTEND_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000

# Logging & rate limiting
LOG_LEVEL=info
RATE_LIMIT_MAX=100
RATE_LIMIT_TIME_WINDOW=1m

# MTN MoMo Sandbox (placeholders)
MTN_API_URL=https://sandbox.momodeveloper.mtn.com
MTN_API_KEY=replace-with-sandbox-key
MTN_API_SECRET=replace-with-sandbox-secret
MTN_API_USER=replace-with-sandbox-api-user
MTN_TARGET_ENVIRONMENT=sandbox
MTN_COLLECTION_SUBSCRIPTION_KEY=replace-with-collection-sub-key
MTN_DISBURSEMENT_SUBSCRIPTION_KEY=replace-with-disbursement-sub-key
MTN_REMITTANCE_SUBSCRIPTION_KEY=replace-with-remittance-sub-key
MTN_SUBSCRIPTION_KEY=replace-with-legacy-sub-key

# Callbacks / Webhooks
MTN_CALLBACK_URL=http://localhost:5000/api/v1/webhooks/mtn
MTN_PROVIDER_CALLBACK_HOST=localhost
WEBHOOK_URL=http://host.docker.internal:5000/api/v1/webhooks/test
WEBHOOK_SECRET=flowpay_webhook_secret_2025

# Orange Money Sandbox (optional placeholders)
ORANGE_API_URL=https://api.orange.com/orange-money-webpay/cm/sandbox
ORANGE_CLIENT_ID=replace-with-orange-client-id
ORANGE_CLIENT_SECRET=replace-with-orange-client-secret
ORANGE_MERCHANT_KEY=replace-with-orange-merchant-key
