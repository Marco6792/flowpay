  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Pre-request script to ensure authentication",
          "if (!pm.environment.get('admin_jwt_token')) {",
          "    console.log('Admin JWT token not set. Please login as admin first.');",
          "}"
        ]
      }
    },
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Global test for authentication errors",
          "if (pm.response.code === 401) {",
          "    console.log('Authentication failed. Please login as admin.');",
          "}",
          "",
          "if (pm.response.code === 403) {",
          "    console.log('Permission denied. Ensure you have the required admin role.');",
          "}"
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:5000",
      "type": "string"
    },
    {
      "key": "admin_jwt_token",
      "value": "",
      "type": "string"
    },
    {
      "key": "fee_structure_id",
      "value": "",
      "type": "string"
    },
    {
      "key": "merchant_user_id",
      "value": "cme9rjyi90000qxwkksbx0073",
      "type": "string"
    }
  ]
}