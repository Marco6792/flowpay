              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"name\": \"Silver Tier\",\n    \"minVolume\": 1000000,\n    \"maxVolume\": 5000000,\n    \"percentage\": 1.2,\n    \"minFee\": 40,\n    \"maxFee\": 4000\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/admin/fees/volume-tiers",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "admin", "fees", "volume-tiers"]
            },
            "description": "Create a volume-based pricing tier (Super Admin only)"
          }
        }
      ]
    },
    {
      "name": "Reports",
      "item": [
        {
          "name": "Get Revenue Report",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/admin/fees/revenue?startDate=2025-01-01&endDate=2025-12-31&groupBy=month",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "admin", "fees", "revenue"],
              "query": [
                {
                  "key": "startDate",
                  "value": "2025-01-01",
                  "description": "Start date (YYYY-MM-DD)"
                },
                {
                  "key": "endDate",
                  "value": "2025-12-31",
                  "description": "End date (YYYY-MM-DD)"
                },
                {
                  "key": "groupBy",
                  "value": "month",
                  "description": "Group by: day, week, or month"
                }
              ]
            },
            "description": "Get fee revenue report with breakdown"
          }
        }
      ]
    },
