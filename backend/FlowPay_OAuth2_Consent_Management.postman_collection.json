    {
      "name": "04. 👤 User Information APIs",
      "item": [
        {
          "name": "Get Basic User Info (without consent)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-API-Key",
                "value": "{{api_key}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}{{api_prefix}}/user/basic/{{test_customer_id}}?provider=MTN",
              "host": ["{{base_url}}"],
              "path": ["{{api_prefix}}", "user", "basic", "{{test_customer_id}}"],
              "query": [
                {
                  "key": "provider",
                  "value": "MTN"
                }
              ]
            },
            "description": "Get basic user information without requiring consent"
          }
        },
        {
          "name": "Get User Info with OAuth2 Token",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-API-Key",
                "value": "{{api_key}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"accessToken\": \"{{oauth2_access_token}}\",\n    \"provider\": \"MTN\"\n}"
            },
            "url": {
              "raw": "{{base_url}}{{api_prefix}}/consent/userinfo",
              "host": ["{{base_url}}"],
              "path": ["{{api_prefix}}", "consent", "userinfo"]
            },
            "description": "Get detailed user information using OAuth2 token"
          }
        },
