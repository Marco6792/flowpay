    {
      "name": "02. 🤝 Consent Authorization Flow",
      "item": [
        {
          "name": "BC-Authorize - Create Consent",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "// Store consent in Supabase database",
                  "if (pm.response.code === 201) {",
                  "    const response = pm.response.json();",
                  "    pm.collectionVariables.set('auth_req_id', response.data.authReqId);",
                  "    ",
                  "    // Store pending consent in Supabase",
                  "    const consentData = {",
                  "        auth_req_id: response.data.authReqId,",
                  "        customer_id: pm.collectionVariables.get('test_customer_id'),",
                  "        business_id: pm.collectionVariables.get('test_business_id'),",
                  "        provider: 'MTN',",
                  "        scope: 'all_info',",
                  "        access_type: 'offline',",
                  "        status: 'pending',",
                  "        interval_seconds: response.data.interval || 5,",
                  "        expires_at: new Date(Date.now() + (response.data.expiresIn * 1000)).toISOString()",
                  "    };",
                  "    ",
                  "    pm.sendRequest({",
                  "        url: pm.collectionVariables.get('supabase_url') + '/rest/v1/oauth2_pending_consents',",
                  "        method: 'POST',",
                  "        header: {",
                  "            'Content-Type': 'application/json',",
                  "            'Authorization': 'Bearer ' + pm.collectionVariables.get('supabase_anon_key'),",
                  "            'apikey': pm.collectionVariables.get('supabase_anon_key')",
                  "        },",
                  "        body: {",
                  "            mode: 'raw',",
                  "            raw: JSON.stringify(consentData)",
                  "        }",
                  "    }, function (err, res) {",
                  "        if (err) {",
                  "            console.log('Failed to store consent in Supabase:', err);",
                  "        } else {",
                  "            console.log('Consent stored in Supabase successfully');",
                  "        }",
                  "    });",
                  "    ",
                  "    pm.test('Consent created successfully', function () {",
                  "        pm.expect(response.success).to.be.true;",
                  "        pm.expect(response.data.authReqId).to.exist;",
                  "    });",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-API-Key",
                "value": "{{api_key}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"customerId\": \"{{test_customer_id}}\",\n    \"scope\": \"profile\",\n    \"accessType\": \"offline\",\n    \"businessId\": \"{{test_business_id}}\",\n    \"description\": \"Authorize FlowPay to access your account\",\n    \"provider\": \"MTN\",\n    \"consentValidIn\": 3600,\n    \"metadata\": {\n        \"type\": \"general_access\",\n        \"purpose\": \"recurring_payments\"\n    }\n}"
            },
            "url": {
              "raw": "{{base_url}}{{api_prefix}}/consent",
              "host": ["{{base_url}}"],
              "path": ["{{api_prefix}}", "consent"]
            }
          }
        },
        {
          "name": "Poll for Token - Check Consent Status",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const response = pm.response.json();",
                  "    pm.collectionVariables.set('oauth2_access_token', response.data.accessToken);",
                  "    pm.collectionVariables.set('oauth2_refresh_token', response.data.refreshToken);",
                  "    ",
                  "    // Store OAuth2 tokens in Supabase",
                  "    const tokenData = {",
                  "        customer_id: pm.collectionVariables.get('test_customer_id'),",
                  "        business_id: pm.collectionVariables.get('test_business_id'),",
                  "        provider: 'MTN',",
                  "        access_token_encrypted: response.data.accessToken, // TODO: Encrypt in production",
                  "        refresh_token_encrypted: response.data.refreshToken, // TODO: Encrypt in production",
                  "        scope: 'all_info',",
                  "        token_type: 'Bearer',",
                  "        expires_at: new Date(Date.now() + (3600 * 1000)).toISOString() // 1 hour",
                  "    };",
                  "    ",
                  "    pm.sendRequest({",
                  "        url: pm.collectionVariables.get('supabase_url') + '/rest/v1/oauth2_tokens',",
                  "        method: 'POST',",
                  "        header: {",
                  "            'Content-Type': 'application/json',",
                  "            'Authorization': 'Bearer ' + pm.collectionVariables.get('supabase_anon_key'),",
                  "            'apikey': pm.collectionVariables.get('supabase_anon_key'),",
                  "            'Prefer': 'resolution=merge-duplicates'",
                  "        },",
                  "        body: {",
                  "            mode: 'raw',",
                  "            raw: JSON.stringify(tokenData)",
                  "        }",
                  "    }, function (err, res) {",
                  "        if (err) {",
                  "            console.log('Failed to store tokens in Supabase:', err);",
                  "        } else {",
                  "            console.log('OAuth2 tokens stored in Supabase successfully');",
                  "        }",
                  "    });",
                  "    ",
                  "    // Log consent approval in audit trail",
                  "    const auditData = {",
                  "        customer_id: pm.collectionVariables.get('test_customer_id'),",
                  "        business_id: pm.collectionVariables.get('test_business_id'),",
                  "        provider: 'MTN',",
                  "        action: 'granted',",
                  "        scope: 'all_info',",
                  "        auth_req_id: pm.collectionVariables.get('auth_req_id'),",
                  "        metadata: {",
                  "            user_agent: 'Postman Collection',",
                  "            test_scenario: 'OAuth2 Consent Flow'",
                  "        }",
                  "    };",
                  "    ",
                  "    pm.sendRequest({",
                  "        url: pm.collectionVariables.get('supabase_url') + '/rest/v1/consent_audit_log',",
                  "        method: 'POST',",
                  "        header: {",
                  "            'Content-Type': 'application/json',",
                  "            'Authorization': 'Bearer ' + pm.collectionVariables.get('supabase_anon_key'),",
                  "            'apikey': pm.collectionVariables.get('supabase_anon_key')",
                  "        },",
                  "        body: {",
                  "            mode: 'raw',",
                  "            raw: JSON.stringify(auditData)",
                  "        }",
                  "    });",
                  "    ",
                  "    pm.test('OAuth2 token received', function () {",
                  "        pm.expect(response.success).to.be.true;",
                  "        pm.expect(response.data.accessToken).to.exist;",
                  "    });",
                  "} else if (pm.response.code === 202) {",
                  "    pm.test('Consent still pending', function () {",
                  "        pm.expect(pm.response.json().error).to.include('pending');",
                  "    });",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-API-Key",
                "value": "{{api_key}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}{{api_prefix}}/consent/token/{{auth_req_id}}?provider=MTN",
              "host": ["{{base_url}}"],
              "path": ["{{api_prefix}}", "consent", "token", "{{auth_req_id}}"],
              "query": [
                {
                  "key": "provider",
                  "value": "MTN"
                }
              ]
            }
          }
        },
        {
          "name": "Get User Info with OAuth2 Token",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('User info retrieved successfully', function () {",
                  "    pm.response.to.have.status(200);",
                  "    const response = pm.response.json();",
                  "    pm.expect(response.success).to.be.true;",
                  "    pm.expect(response.data.userInfo).to.exist;",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-API-Key",
                "value": "{{api_key}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"accessToken\": \"{{oauth2_access_token}}\",\n    \"provider\": \"MTN\"\n}"
            },
            "url": {
              "raw": "{{base_url}}{{api_prefix}}/consent/userinfo",
              "host": ["{{base_url}}"],
              "path": ["{{api_prefix}}", "consent", "userinfo"]
            }
          }
        },
        {
          "name": "Refresh OAuth2 Token",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Token refreshed successfully', function () {",
                  "    pm.response.to.have.status(200);",
                  "    const response = pm.response.json();",
                  "    pm.expect(response.success).to.be.true;",
                  "    pm.expect(response.data.accessToken).to.exist;",
                  "    pm.collectionVariables.set('oauth2_access_token', response.data.accessToken);",
                  "    if (response.data.refreshToken) {",
                  "        pm.collectionVariables.set('oauth2_refresh_token', response.data.refreshToken);",
                  "    }",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-API-Key",
                "value": "{{api_key}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"refreshToken\": \"{{oauth2_refresh_token}}\",\n    \"provider\": \"MTN\"\n}"
            },
            "url": {
              "raw": "{{base_url}}{{api_prefix}}/consent/refresh",
              "host": ["{{base_url}}"],
              "path": ["{{api_prefix}}", "consent", "refresh"]
            }
          }
        },
        {
          "name": "Revoke Consent",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Consent revoked successfully', function () {",
                  "    pm.response.to.have.status(200);",
                  "    const response = pm.response.json();",
                  "    pm.expect(response.success).to.be.true;",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-API-Key",
                "value": "{{api_key}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"accessToken\": \"{{oauth2_access_token}}\",\n    \"provider\": \"MTN\"\n}"
            },
            "url": {
              "raw": "{{base_url}}{{api_prefix}}/consent/revoke",
              "host": ["{{base_url}}"],
              "path": ["{{api_prefix}}", "consent", "revoke"]
            }
          }
        }
      ]
    },
