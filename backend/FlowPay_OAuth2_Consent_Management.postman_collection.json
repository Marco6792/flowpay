    {
      "name": "06. 🔄 Direct MTN API Calls",
      "item": [
        {
          "name": "Direct BC-Authorize (MTN)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{mtn_access_token}}"
              },
              {
                "key": "X-Target-Environment",
                "value": "sandbox"
              },
              {
                "key": "Ocp-Apim-Subscription-Key",
                "value": "{{mtn_remittance_subscription_key}}"
              },
              {
                "key": "Content-Type",
                "value": "application/x-www-form-urlencoded"
              }
            ],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "login_hint",
                  "value": "ID:{{test_customer_id}}/MSISDN",
                  "type": "text"
                },
                {
                  "key": "scope",
                  "value": "profile",
                  "type": "text"
                },
                {
                  "key": "access_type",
                  "value": "offline",
                  "type": "text"
                }
              ]
            },
            "url": {
              "raw": "{{mtn_sandbox_url}}/remittance/v1_0/bc-authorize",
              "host": ["{{mtn_sandbox_url}}"],
              "path": ["remittance", "v1_0", "bc-authorize"]
            }
          }
        },
        {
          "name": "Direct OAuth2 Token (MTN)",
          "request": {
            "auth": {
              "type": "basic",
              "basic": [
                {
                  "key": "username",
                  "value": "{{mtn_api_user}}"
                },
                {
                  "key": "password",
                  "value": "{{mtn_api_key}}"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "X-Target-Environment",
                "value": "sandbox"
              },
              {
                "key": "Ocp-Apim-Subscription-Key",
                "value": "{{mtn_remittance_subscription_key}}"
              },
              {
                "key": "Content-Type",
                "value": "application/x-www-form-urlencoded"
              }
            ],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "grant_type",
                  "value": "urn:openid:params:grant-type:ciba",
                  "type": "text"
                },
                {
                  "key": "auth_req_id",
                  "value": "{{auth_req_id}}",
                  "type": "text"
                }
              ]
            },
            "url": {
              "raw": "{{mtn_sandbox_url}}/remittance/oauth2/token/",
              "host": ["{{mtn_sandbox_url}}"],
              "path": ["remittance", "oauth2", "token", ""]
            }
          }
        },
        {
          "name": "Direct User Info (MTN)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{oauth2_access_token}}"
              },
              {
                "key": "X-Target-Environment",
                "value": "sandbox"
              },
              {
                "key": "Ocp-Apim-Subscription-Key",
                "value": "{{mtn_remittance_subscription_key}}"
              }
            ],
            "url": {
              "raw": "{{mtn_sandbox_url}}/remittance/oauth2/v1_0/userinfo",
              "host": ["{{mtn_sandbox_url}}"],
              "path": ["remittance", "oauth2", "v1_0", "userinfo"]
            }
          }
        }
      ]
    }
  ]
