  "item": [
    {
      "name": "01. 🔐 OAuth2 Setup & Configuration",
      "item": [
        {
          "name": "Create API User (MTN Direct)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "pm.variables.set('x_reference_id', pm.variables.replaceIn('{{$guid}}'));"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('API User created successfully', function () {",
                  "    pm.response.to.have.status(201);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-Reference-Id",
                "value": "{{x_reference_id}}"
              },
              {
                "key": "Ocp-Apim-Subscription-Key",
                "value": "{{mtn_remittance_subscription_key}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"providerCallbackHost\": \"{{webhook_host}}\"\n}"
            },
            "url": {
              "raw": "{{mtn_sandbox_url}}/v1_0/apiuser",
              "host": ["{{mtn_sandbox_url}}"],
              "path": ["v1_0", "apiuser"]
            }
          }
        },
        {
          "name": "Generate API Key (MTN Direct)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('API Key generated successfully', function () {",
                  "    pm.response.to.have.status(201);",
                  "    const response = pm.response.json();",
                  "    pm.environment.set('mtn_api_key', response.apiKey);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Ocp-Apim-Subscription-Key",
                "value": "{{mtn_remittance_subscription_key}}"
              }
            ],
            "url": {
              "raw": "{{mtn_sandbox_url}}/v1_0/apiuser/{{x_reference_id}}/apikey",
              "host": ["{{mtn_sandbox_url}}"],
              "path": ["v1_0", "apiuser", "{{x_reference_id}}", "apikey"]
            }
          }
        },
        {
          "name": "Get Access Token (for API operations)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Access token received', function () {",
                  "    pm.response.to.have.status(200);",
                  "    const response = pm.response.json();",
                  "    pm.environment.set('mtn_access_token', response.access_token);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "basic",
              "basic": [
                {
                  "key": "username",
                  "value": "{{mtn_api_user}}"
                },
                {
                  "key": "password",
                  "value": "{{mtn_api_key}}"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Ocp-Apim-Subscription-Key",
                "value": "{{mtn_remittance_subscription_key}}"
              },
              {
                "key": "X-Target-Environment",
                "value": "sandbox"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{mtn_sandbox_url}}/remittance/token/",
              "host": ["{{mtn_sandbox_url}}"],
              "path": ["remittance", "token", ""]
            }
          }
        }
      ]
