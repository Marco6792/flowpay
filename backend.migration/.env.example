# Server Configuration
NODE_ENV=development
PORT=5000
HOST=0.0.0.0

# Database Configuration
# For Supabase + Prisma:
# DATABASE_URL should use transaction pooler endpoint (usually port 6543)
# DIRECT_URL should use a session/direct endpoint where possible.
# If your network blocks those endpoints, fallback to 6543 can work for db push.
DATABASE_URL="postgresql://postgres.<project-ref>:password@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1&sslmode=require"
DIRECT_URL="postgresql://postgres.<project-ref>:password@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1&sslmode=require"

# Redis Configuration
REDIS_URL="redis://localhost:6379"

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# API Configuration
API_PREFIX=/api/v1

# Rate Limiting
RATE_LIMIT_MAX=100
RATE_LIMIT_TIME_WINDOW=1m

# Logging
LOG_LEVEL=info

# CORS
CORS_ORIGIN=http://localhost:3001

# API URLs
API_URL=http://localhost:5000
FRONTEND_URL=http://localhost:3000

# MTN Mobile Money Provider Settings
# Base API URL - Use sandbox for testing, production URL varies by country
MTN_API_URL=https://sandbox.momodeveloper.mtn.com
# For production use: https://proxy.momoapi.mtn.com (or country-specific URL)

# API Credentials (Required for Authentication)
MTN_API_KEY=your-mtn-api-key
MTN_API_SECRET=your-mtn-api-secret
MTN_API_USER=your-mtn-api-user-id  # API User ID (auto-generated in sandbox)

# Environment Configuration
MTN_TARGET_ENVIRONMENT=sandbox  # Options: sandbox, production

# Subscription Keys for Different MoMo Products
# Get these from https://momodeveloper.mtn.com/profile after subscribing to products
MTN_COLLECTION_SUBSCRIPTION_KEY=your-collection-subscription-key  # For receiving payments
MTN_DISBURSEMENT_SUBSCRIPTION_KEY=your-disbursement-subscription-key  # For sending money
MTN_REMITTANCE_SUBSCRIPTION_KEY=your-remittance-subscription-key  # For international transfers
MTN_SANDBOX_PROVISIONING_KEY=your-sandbox-provisioning-subscription-key  # For creating sandbox API users

# Legacy subscription key (kept for backward compatibility)
MTN_SUBSCRIPTION_KEY=your-mtn-subscription-key

# Callback Configuration
MTN_CALLBACK_URL=https://your-domain.com/api/v1/webhooks/mtn  # Your webhook endpoint
MTN_PROVIDER_CALLBACK_HOST=your-domain.com  # Provider callback host (optional)

# Orange Money Provider Settings
ORANGE_API_URL=https://api.orange.com/orange-money-webpay/cm/sandbox
ORANGE_CLIENT_ID=your-orange-client-id
ORANGE_CLIENT_SECRET=your-orange-client-secret
ORANGE_MERCHANT_KEY=your-orange-merchant-key

# Webhook Configuration
WEBHOOK_URL=https://your-webhook-endpoint.com/webhooks
WEBHOOK_SECRET=flowpay_webhook_secret_2025
