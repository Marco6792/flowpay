    {
      "name": "4. Generate Access Tokens",
      "item": [
        {
          "name": "Collection - Create Access Token",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200 - Token Created', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "var jsonData = pm.response.json();",
                  "if (jsonData.access_token) {",
                  "    pm.environment.set('MTN_COLLECTION_TOKEN', jsonData.access_token);",
                  "    console.log('MTN_COLLECTION_TOKEN saved, expires in:', jsonData.expires_in, 'seconds');",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "basic",
              "basic": [
                { "key": "username", "value": "{{MTN_API_USER}}", "type": "string" },
                { "key": "password", "value": "{{MTN_API_KEY}}", "type": "string" }
              ]
            },
            "method": "POST",
            "header": [
              { "key": "Ocp-Apim-Subscription-Key", "value": "{{MTN_COLLECTION_SUBSCRIPTION_KEY}}" }
            ],
            "url": {
              "raw": "{{MTN_COLLECTION_URL}}/token/",
              "host": ["{{MTN_COLLECTION_URL}}"],
              "path": ["token", ""]
            },
            "description": "Generate Bearer token for Collection API.\n\nMTN API: POST /collection/token/"
          }
        },
