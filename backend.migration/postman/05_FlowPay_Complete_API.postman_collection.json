{
  "info": {
    "_postman_id": "fp-complete-api-005",
    "name": "05 - FlowPay Complete API",
    "description": "Complete FlowPay API collection for testing all backend endpoints.\n\nScenario Mapping (FlowPay → MTN):\n- FlowPay Payments → MTN Collection RequestToPay\n- FlowPay Transfers → MTN Disbursement Transfer\n- FlowPay Deposits → MTN Disbursement Deposit\n- FlowPay Withdrawals → MTN Collection RequestToWithdraw\n- FlowPay Refunds → MTN Disbursement Refund\n- FlowPay Invoices → MTN Collection Invoice\n- FlowPay Pre-Approvals → MTN Collection PreApproval\n- FlowPay Consent → MTN OAuth2 bc-authorize\n- FlowPay Remittance → MTN Remittance CashTransfer\n\nRequires: FlowPay backend running at {{FLOWPAY_BASE_URL}}",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Health Check",
      "item": [
        {
          "name": "Health Check",
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Status 200', function () { pm.response.to.have.status(200); });"], "type": "text/javascript" } }],
          "request": { "method": "GET", "url": { "raw": "{{FLOWPAY_BASE_URL}}/health", "host": ["{{FLOWPAY_BASE_URL}}"], "path": ["health"] } }
        },
        {
          "name": "Ready Check",
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Status 200', function () { pm.response.to.have.status(200); });"], "type": "text/javascript" } }],
          "request": { "method": "GET", "url": { "raw": "{{FLOWPAY_BASE_URL}}/health/ready", "host": ["{{FLOWPAY_BASE_URL}}"], "path": ["health", "ready"] } }
        }
      ]
    },
    {
      "name": "2. Authentication",
      "item": [
        {
          "name": "Register Merchant",
          "event": [{ "listen": "test", "script": { "exec": ["var code = pm.response.code;", "pm.test('Status 201 or 200', function () { pm.expect(code).to.be.oneOf([200, 201]); });", "var data = pm.response.json();", "if (data.token) pm.environment.set('FLOWPAY_JWT_TOKEN', data.token);", "if (data.user && data.user.id) pm.environment.set('MERCHANT_ID', data.user.id);"], "type": "text/javascript" } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"username\": \"{{MERCHANT_USERNAME}}\",\n  \"password\": \"{{MERCHANT_PASSWORD}}\",\n  \"email\": \"test@flowpay.com\",\n  \"businessName\": \"Test Merchant\"\n}" },
            "url": { "raw": "{{FLOWPAY_BASE_URL}}/auth/register", "host": ["{{FLOWPAY_BASE_URL}}"], "path": ["auth", "register"] }
          }
        },
        {
          "name": "Login Merchant",
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Status 200', function () { pm.response.to.have.status(200); });", "var data = pm.response.json();", "if (data.token) pm.environment.set('FLOWPAY_JWT_TOKEN', data.token);", "if (data.user && data.user.id) pm.environment.set('MERCHANT_ID', data.user.id);"], "type": "text/javascript" } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"username\": \"{{MERCHANT_USERNAME}}\",\n  \"password\": \"{{MERCHANT_PASSWORD}}\"\n}" },
            "url": { "raw": "{{FLOWPAY_BASE_URL}}/auth/login", "host": ["{{FLOWPAY_BASE_URL}}"], "path": ["auth", "login"] }
          }
        },
        {
          "name": "Create API Key",
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Status 201', function () { pm.response.to.have.status(201); });", "var data = pm.response.json();", "if (data.key) pm.environment.set('FLOWPAY_API_KEY', data.key);", "if (data.id) pm.environment.set('API_KEY_ID', data.id);"], "type": "text/javascript" } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{FLOWPAY_JWT_TOKEN}}" }, { "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Test API Key\",\n  \"permissions\": [\"payments\", \"transfers\", \"balance\"]\n}" },
            "url": { "raw": "{{FLOWPAY_BASE_URL}}/auth/api-keys", "host": ["{{FLOWPAY_BASE_URL}}"], "path": ["auth", "api-keys"] }
          }
        },
        {
          "name": "List API Keys",
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Status 200', function () { pm.response.to.have.status(200); });"], "type": "text/javascript" } }],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{FLOWPAY_JWT_TOKEN}}" }],
            "url": { "raw": "{{FLOWPAY_BASE_URL}}/auth/api-keys", "host": ["{{FLOWPAY_BASE_URL}}"], "path": ["auth", "api-keys"] }
          }
        },
        {
          "name": "Revoke API Key",
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Status 200', function () { pm.response.to.have.status(200); });"], "type": "text/javascript" } }],
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{FLOWPAY_JWT_TOKEN}}" }],
            "url": { "raw": "{{FLOWPAY_BASE_URL}}/auth/api-keys/{{API_KEY_ID}}", "host": ["{{FLOWPAY_BASE_URL}}"], "path": ["auth", "api-keys", "{{API_KEY_ID}}"] }
          }
        }
      ]
    },
    {
      "name": "3. Admin",
      "item": [
        {
          "name": "Register Admin",
          "event": [{ "listen": "test", "script": { "exec": ["var data = pm.response.json();", "if (data.token) pm.environment.set('FLOWPAY_ADMIN_TOKEN', data.token);"], "type": "text/javascript" } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"username\": \"{{ADMIN_USERNAME}}\",\n  \"password\": \"{{ADMIN_PASSWORD}}\",\n  \"email\": \"admin@flowpay.com\"\n}" },
            "url": { "raw": "{{FLOWPAY_BASE_URL}}/admin/auth/register", "host": ["{{FLOWPAY_BASE_URL}}"], "path": ["admin", "auth", "register"] }
          }
        },
        {
          "name": "Login Admin",
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Status 200', function () { pm.response.to.have.status(200); });", "var data = pm.response.json();", "if (data.token) pm.environment.set('FLOWPAY_ADMIN_TOKEN', data.token);"], "type": "text/javascript" } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"username\": \"{{ADMIN_USERNAME}}\",\n  \"password\": \"{{ADMIN_PASSWORD}}\"\n}" },
            "url": { "raw": "{{FLOWPAY_BASE_URL}}/admin/auth/login", "host": ["{{FLOWPAY_BASE_URL}}"], "path": ["admin", "auth", "login"] }
          }
        },
        {
          "name": "Get Current Admin",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{FLOWPAY_ADMIN_TOKEN}}" }],
            "url": { "raw": "{{FLOWPAY_BASE_URL}}/admin/auth/me", "host": ["{{FLOWPAY_BASE_URL}}"], "path": ["admin", "auth", "me"] }
          }
        },
        {
          "name": "Create Fee Structure",
          "event": [{ "listen": "test", "script": { "exec": ["var data = pm.response.json();", "if (data.id) pm.environment.set('FEE_STRUCTURE_ID', data.id);"], "type": "text/javascript" } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{FLOWPAY_ADMIN_TOKEN}}" }, { "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Standard Fee\",\n  \"type\": \"percentage\",\n  \"value\": 2.5,\n  \"minAmount\": 0,\n  \"maxAmount\": 1000000,\n  \"currency\": \"{{TEST_CURRENCY}}\"\n}" },
            "url": { "raw": "{{FLOWPAY_BASE_URL}}/admin/fees", "host": ["{{FLOWPAY_BASE_URL}}"], "path": ["admin", "fees"] }
          }
        },
        {
          "name": "List Fee Structures",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{FLOWPAY_ADMIN_TOKEN}}" }],
            "url": { "raw": "{{FLOWPAY_BASE_URL}}/admin/fees", "host": ["{{FLOWPAY_BASE_URL}}"], "path": ["admin", "fees"] }
          }
        },
        {
          "name": "Update Fee Structure",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Authorization", "value": "Bearer {{FLOWPAY_ADMIN_TOKEN}}" }, { "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"value\": 3.0\n}" },
            "url": { "raw": "{{FLOWPAY_BASE_URL}}/admin/fees/{{FEE_STRUCTURE_ID}}", "host": ["{{FLOWPAY_BASE_URL}}"], "path": ["admin", "fees", "{{FEE_STRUCTURE_ID}}"] }
          }
        },
        {
          "name": "Assign Fee to Merchant",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{FLOWPAY_ADMIN_TOKEN}}" }, { "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"merchantId\": \"{{MERCHANT_ID}}\",\n  \"feeStructureId\": \"{{FEE_STRUCTURE_ID}}\"\n}" },
            "url": { "raw": "{{FLOWPAY_BASE_URL}}/admin/fees/assign", "host": ["{{FLOWPAY_BASE_URL}}"], "path": ["admin", "fees", "assign"] }
          }
        },
        {
          "name": "Calculate Fee",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{FLOWPAY_ADMIN_TOKEN}}" }],
            "url": { "raw": "{{FLOWPAY_BASE_URL}}/admin/fees/calculate?amount={{TEST_AMOUNT}}&merchantId={{MERCHANT_ID}}", "host": ["{{FLOWPAY_BASE_URL}}"], "path": ["admin", "fees", "calculate"], "query": [{ "key": "amount", "value": "{{TEST_AMOUNT}}" }, { "key": "merchantId", "value": "{{MERCHANT_ID}}" }] }
          }
        },
        {
          "name": "Get Revenue Report",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{FLOWPAY_ADMIN_TOKEN}}" }],
            "url": { "raw": "{{FLOWPAY_BASE_URL}}/admin/fees/revenue", "host": ["{{FLOWPAY_BASE_URL}}"], "path": ["admin", "fees", "revenue"] }
          }
        }
      ]
    },
    {
      "name": "4. Payments (→ MTN Collection: RequestToPay)",
      "description": "FlowPay payment endpoints.\n\nMTN Scenario: POST /collection/v1_0/requesttopay\nFlowPay Scenario: POST /api/v1/payments",
      "item": [
        {
          "name": "Create Payment (MTN)",
          "event": [{ "listen": "test", "script": { "exec": ["var code = pm.response.code;", "pm.test('Status 201 or 202', function () { pm.expect(code).to.be.oneOf([200, 201, 202]); });", "var data = pm.response.json();", "if (data.id) pm.environment.set('PAYMENT_ID', data.id);", "if (data.transactionId) pm.environment.set('PAYMENT_ID', data.transactionId);"], "type": "text/javascript" } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{FLOWPAY_JWT_TOKEN}}" }, { "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"amount\": {{TEST_AMOUNT}},\n  \"currency\": \"{{TEST_CURRENCY}}\",\n  \"phoneNumber\": \"{{TEST_MSISDN}}\",\n  \"provider\": \"mtn\",\n  \"externalId\": \"fp-pay-{{$timestamp}}\",\n  \"payerMessage\": \"FlowPay payment test\",\n  \"payeeNote\": \"Test payment\"\n}" },
            "url": { "raw": "{{FLOWPAY_BASE_URL}}/payments", "host": ["{{FLOWPAY_BASE_URL}}"], "path": ["payments"] },
            "description": "Create payment via FlowPay.\n\nFlowPay: POST /payments\nMTN: POST /collection/v1_0/requesttopay"
          }
        },
        {
          "name": "Create Payment V2",
          "event": [{ "listen": "test", "script": { "exec": ["var data = pm.response.json();", "if (data.id) pm.environment.set('PAYMENT_ID', data.id);", "if (data.transactionId) pm.environment.set('PAYMENT_ID', data.transactionId);"], "type": "text/javascript" } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{FLOWPAY_JWT_TOKEN}}" }, { "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"amount\": {{TEST_AMOUNT}},\n  \"currency\": \"{{TEST_CURRENCY}}\",\n  \"phoneNumber\": \"{{TEST_MSISDN}}\",\n  \"provider\": \"mtn\",\n  \"externalId\": \"fp-payv2-{{$timestamp}}\",\n  \"payerMessage\": \"FlowPay V2 payment\",\n  \"payeeNote\": \"V2 test\"\n}" },
            "url": { "raw": "{{FLOWPAY_BASE_URL}}/payments/v2", "host": ["{{FLOWPAY_BASE_URL}}"], "path": ["payments", "v2"] },
            "description": "FlowPay: POST /payments/v2\nMTN: POST /collection/v2_0/payment"
          }
        },
        {
          "name": "Get Payment",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{FLOWPAY_JWT_TOKEN}}" }],
            "url": { "raw": "{{FLOWPAY_BASE_URL}}/payments/{{PAYMENT_ID}}", "host": ["{{FLOWPAY_BASE_URL}}"], "path": ["payments", "{{PAYMENT_ID}}"] },
            "description": "FlowPay: GET /payments/{id}\nMTN: GET /collection/v1_0/requesttopay/{referenceId}"
          }
        },
        {
          "name": "Get Payment Status V2",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{FLOWPAY_JWT_TOKEN}}" }],
            "url": { "raw": "{{FLOWPAY_BASE_URL}}/payments/{{PAYMENT_ID}}/status", "host": ["{{FLOWPAY_BASE_URL}}"], "path": ["payments", "{{PAYMENT_ID}}", "status"] },
            "description": "FlowPay: GET /payments/{id}/status\nMTN: GET /collection/v2_0/payment/{referenceId}"
          }
        },
        {
          "name": "List Payments",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{FLOWPAY_JWT_TOKEN}}" }],
            "url": { "raw": "{{FLOWPAY_BASE_URL}}/payments", "host": ["{{FLOWPAY_BASE_URL}}"], "path": ["payments"] }
          }
        },
        {
          "name": "Get Payment Stats",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{FLOWPAY_JWT_TOKEN}}" }],
            "url": { "raw": "{{FLOWPAY_BASE_URL}}/payments/stats", "host": ["{{FLOWPAY_BASE_URL}}"], "path": ["payments", "stats"] }
          }
        },
        {
          "name": "Send Notification",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{FLOWPAY_JWT_TOKEN}}" }, { "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"message\": \"Your payment is confirmed. Thank you!\"\n}" },
            "url": { "raw": "{{FLOWPAY_BASE_URL}}/payments/{{PAYMENT_ID}}/notify", "host": ["{{FLOWPAY_BASE_URL}}"], "path": ["payments", "{{PAYMENT_ID}}", "notify"] },
            "description": "FlowPay: POST /payments/{id}/notify\nMTN: POST /collection/v1_0/requesttopay/{ref}/deliverynotification"
          }
        },
        {
          "name": "Cancel Payment",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{FLOWPAY_JWT_TOKEN}}" }],
            "url": { "raw": "{{FLOWPAY_BASE_URL}}/payments/{{PAYMENT_ID}}", "host": ["{{FLOWPAY_BASE_URL}}"], "path": ["payments", "{{PAYMENT_ID}}"] }
          }
        }
      ]
    },
