      "item": [
        {
          "name": "Create Consent",
          "event": [{ "listen": "test", "script": { "exec": ["var data = pm.response.json();", "if (data.id) pm.environment.set('CONSENT_ID', data.id);", "if (data.authReqId) pm.environment.set('MTN_AUTH_REQ_ID', data.authReqId);"], "type": "text/javascript" } }],
          "request": {
