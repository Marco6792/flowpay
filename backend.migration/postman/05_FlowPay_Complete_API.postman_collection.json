    {
      "name": "7. Deposits (→ MTN Disbursement: Deposit)",
      "description": "FlowPay deposit endpoints.\n\nMTN Scenario: POST /disbursement/v1_0/deposit\nFlowPay Scenario: POST /api/v1/deposits",
      "item": [
        {
          "name": "Create Deposit",
          "event": [{ "listen": "test", "script": { "exec": ["var data = pm.response.json();", "if (data.id) pm.environment.set('DEPOSIT_ID', data.id);"], "type": "text/javascript" } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{FLOWPAY_JWT_TOKEN}}" }, { "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"amount\": {{TEST_AMOUNT}},\n  \"currency\": \"{{TEST_CURRENCY}}\",\n  \"phoneNumber\": \"{{TEST_MSISDN}}\",\n  \"provider\": \"mtn\",\n  \"externalId\": \"fp-deposit-{{$timestamp}}\"\n}" },
            "url": { "raw": "{{FLOWPAY_BASE_URL}}/deposits", "host": ["{{FLOWPAY_BASE_URL}}"], "path": ["deposits"] }
          }
        },
        {
          "name": "Create Deposit V2",
          "event": [{ "listen": "test", "script": { "exec": ["var data = pm.response.json();", "if (data.id) pm.environment.set('DEPOSIT_ID', data.id);"], "type": "text/javascript" } }],
          "request": {
